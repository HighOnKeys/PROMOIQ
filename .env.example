# Copy to .env (never commit .env). Everything works offline with the defaults.

# Model provider: heuristic (offline, free, default) | gemini | anthropic | openai_compat
PROMOIQ_PROVIDER=heuristic
PROMOIQ_MODEL=
# Optional: use a different (e.g. stronger) model for the judges than for generation
PROMOIQ_JUDGE_PROVIDER=
PROMOIQ_JUDGE_MODEL=

# Keys are read from the environment only
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# For Groq / OpenRouter / a local vLLM or Ollama server exposing /v1/chat/completions
OPENAI_BASE_URL=https://api.openai.com/v1

# Input folder (episode .txt files) or a .zip
PROMOIQ_INPUT=data/input

# Free-tier friendly settings (Gemini free tier: ~20 requests/day/model, ~5/minute)
PROMOIQ_LLM_EPISODES_PER_CALL=1      # 5 = annotate 50 episodes in 10 calls
PROMOIQ_JUDGE_BUDGET=30              # distinct candidates judged by the LLM (2 calls each)
PROMOIQ_MIN_CALL_INTERVAL_S=         # default 13 for gemini
PROMOIQ_GEMINI_THINKING_BUDGET=0     # 0 = no thinking tokens on Flash (faster, cheaper); empty = model default
